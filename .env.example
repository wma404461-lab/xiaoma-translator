# 本地模型模式，不需要任何 API 密钥。
PORT=4317
# 可选：将模型缓存放到空间足够的磁盘。先设置，再执行 setup-local.ps1。
# FLOWSUB_CACHE=C:\Users\your-name\.cache\flowsub
# FLOWSUB_GPU_LAYERS=99
# 无可用 NVIDIA GPU 时可设为 0，CPU 翻译速度会下降。
# FLOWSUB_ASR_DEVICE=auto
# 可设为 cpu 禁用识别 GPU；auto 在显存足够时启用，并在 DLL 不可用时回退到 CPU。
# FLOWSUB_TRANSLATION_MODEL=C:\Users\your-name\.cache\flowsub\Qwen_Qwen3-4B-Instruct-2507-Q4_K_M.gguf
